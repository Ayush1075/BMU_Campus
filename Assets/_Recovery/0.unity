--- !u!114 &776609773
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 776609772}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d6052b3ea46ad8a4a9dd26224d1f730f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BMU.Tour.BMUTourController
  slides:
  - tag: HERO GROUP LEGACY
    title: Welcome to BML Munjal University
    body: Named after the visionary founder of the Hero Group, Shri Brijmohan Lall
      Munjal, BMU was established to transform higher education through hands-on
      experiential learning, ethical leadership, and real-world industrial impact.
    narration: Welcome to BML Munjal University. Founded by the Hero Group, BMU nurtures
      ethical leaders equipped with experiential knowledge.
    cta: Next Highlight
    chips:
    - Founded by Hero Group
    - Mentored by Imperial College London
    - "Experiential 3\u20132\u20131 Learning"
    captions:
    - BMU Front Entrance
    - Student Collaborative Quad
    - Academic Campus Skyline
    photos:
    - {fileID: 0}
    - {fileID: 0}
    - {fileID: 0}
  - tag: ACADEMIC EXCELLENCE
    title: Achievements & Global Accreditations
    body: BMU is ranked among the top 100 universities nationally in the NIRF rankings.
      With a QS I-GAUGE Diamond rating, university-wide patent programs, and academic
      collaboration with Imperial College London, our graduates enter top global
      corporations and research institutions.
    narration: Ranked among India's top 100 by NIRF, BMU delivers globally benchmarked
      academic rigor and international collaboration.
    cta: Next Highlight
    chips:
    - Top 100 NIRF Ranked
    - QS I-GAUGE Diamond
    - 100+ Corporate Recruiting Partners
    captions:
    - Annual Convocation Hall
    - Industry Collaboration
    - Research Excellence Awards
    photos:
    - {fileID: 0}
    - {fileID: 0}
    - {fileID: 0}
  - tag: CURRICULUM & SCHOOLS
    title: Schools & Experiential Programs
    body: Our schools of Engineering & Technology, Management, Law, and Liberal Studies
      emphasize interdisciplinary learning. 45% of every student's time is dedicated
      to hands-on lab work, maker studios, live venture creation, and corporate internships.
    narration: Through Engineering, Management, and Law, students spend over 45%
      of their curriculum in live, practical laboratories.
    cta: Next Highlight
    chips:
    - "SOET \u2022 SOM \u2022 SOL \u2022 SOLS"
    - 45% Practical Hands-on Labs
    - "B.Tech \u2022 MBA \u2022 Law \u2022 PhD"
    captions:
    - Advanced Robotics Testing
    - Management Case Discussion
    - Moot Courtroom Sessions
    photos:
    - {fileID: 0}
    - {fileID: 0}
    - {fileID: 0}
  - tag: INFRASTRUCTURE & LABS
    title: World-Class 50-Acre Campus
    body: A fully residential, green, and sustainable campus equipped with cutting-edge
      academic spaces, dedicated Maker's spaces, IoT and Siemens engineering labs,
      campus-wide high-speed Wi-Fi, and 24/7 student activity hubs.
    narration: Our 50-acre green residential campus offers cutting-edge research
      facilities, modern residences, and continuous learning spaces.
    cta: Next Highlight
    chips:
    - 50-Acre Green Campus
    - Siemens Centre of Excellence
    - 100% Residential Community
    captions:
    - Central Library & Atrium
    - IoT & Electronics Studio
    - Smart Tiered Auditorium
    photos:
    - {fileID: 0}
    - {fileID: 0}
    - {fileID: 0}
  - tag: STUDENT LIFE & CULTURE
    title: Vibrant Campus Life, Fests & Sports
    body: Life at BMU thrives beyond academics. With over 25 student clubs, the flagship
      annual cultural fest '67th Milestone', national hackathons, and world-class
      athletic facilities, students develop holistic character, teamwork, and lifelong
      friendships.
    narration: From our signature festival 67th Milestone to 25+ student-led clubs
      and sports, campus life at BMU is full of energy and creativity.
    cta: Start Campus Tour
    chips:
    - '''67th Milestone'' Annual Fest'
    - 25+ Student-Run Clubs
    - Olympic-Grade Sports Complexes
    captions:
    - '''67th Milestone Rock Night'
    - Inter-University Sports Arena
    - Student Technical Hackathon
    photos:
    - {fileID: 0}
    - {fileID: 0}
    - {fileID: 0}
  buildings:
  - id: north-block
    name: North Block
    displayName: North Block
    card:
      tag: ACADEMIC HUB
      title: North Block Building
      description: School of Engineering & Technology, School of Management, smart
        classrooms, AI/robotics labs, and 4th-floor faculty mentorship suites.
      footer: 3 Internal Spaces
      tagStyle: 0
      gradientTop: {r: 0.165, g: 0.353, b: 0.518, a: 1}
      gradientBottom: {r: 0.043, g: 0.192, b: 0.318, a: 1}
      photo: {fileID: 0}
    exterior:
      tag1: ACADEMIC COMPLEX (EXTERIOR)
      tag2: "LIVE 360\xB0 VIEW"
      title: North Block Academic Building
      body: The North Block is the premier academic complex for the School of Engineering
        & Technology and School of Management. Its modern red-brick architecture
        houses multi-tiered smart classrooms, computational labs, and faculty research
        suites.
      narration: You are outside the North Block, the academic heartbeat of BMU housing
        engineering, management, and faculty cabins.
      status: OUTSIDE NORTH BLOCK BUILDING
      photoCaption: "North Block Red-Brick Academic Fa\xE7ade"
      chips:
      - School of Engineering & Tech
      - School of Management
      - Faculty Research Suites
      - Smart Pedagogy Halls
      photo: {fileID: 0}
    rooms:
    - selectorTitle: Smart Classroom
      selectorSubtitle: Tiered Amphitheater & Digital Pedagogy
      place:
        tag1: "NORTH BLOCK \u2022 INTERIOR"
        tag2: "LIVE 360\xB0 VIEW"
        title: Tiered Multimedia Smart Classroom
        body: Engineered for interactive student-centric pedagogy, this smart classroom
          features amphitheater-style tiered seating, dual high-definition projection
          systems, interactive smartboards, and recording cameras for hybrid global
          lectures.
        narration: Inside the North Block smart classroom, amphitheater seating and
          multimedia displays encourage dynamic faculty-student interaction.
        status: 'NORTH BLOCK: SMART CLASSROOM'
        photoCaption: Tiered Executive Smart Classroom
        chips:
        - Amphitheater Tiered Seating
        - Dual HD Smart Displays
        - Acoustic Audio Systems
        - Hybrid Lecture Capture
        photo: {fileID: 0}
    - selectorTitle: Engineering Lab
      selectorSubtitle: AI, IoT & Robotics Workstations
      place:
        tag1: "NORTH BLOCK \u2022 INTERIOR"
        tag2: "LIVE 360\xB0 VIEW"
        title: Engineering Lab
        body: Hands-on workstations for AI, IoT and Robotics, where B.Tech students
          build, test and iterate on real hardware and software projects alongside
          faculty mentors.
        narration: In the engineering lab, students build and test AI, IoT and robotics
          projects on real hardware, guided by faculty mentors.
        status: 'NORTH BLOCK: ENGINEERING LAB'
        photoCaption: Engineering Lab Workstations
        chips:
        - AI Workstations
        - IoT Prototyping Benches
        - Robotics & Automation Kits
        - Maker Space Access
        photo: {fileID: 0}
    - selectorTitle: 4th Floor Faculty Cabins
      selectorSubtitle: 1-on-1 Faculty Mentorship & Research
      place:
        tag1: "NORTH BLOCK \u2022 INTERIOR"
        tag2: "LIVE 360\xB0 VIEW"
        title: 4th Floor Faculty Cabins
        body: Private faculty cabins and research suites where students meet their
          mentors for one-on-one guidance, research supervision, and career advice.
        narration: On the fourth floor, faculty cabins make one-on-one mentorship
          and research guidance part of everyday learning.
        status: 'NORTH BLOCK: FACULTY CABINS'
        photoCaption: Faculty Research Suites
        chips:
        - 1-on-1 Mentorship
        - Research Supervision
        - Open-Door Faculty Culture
        photo: {fileID: 0}
  - id: gateway
    name: Gateway
    displayName: Gateway Building
    card:
      tag: ACADEMIC & ADMIN
      title: Gateway Building
      description: Flagship architectural centerpiece with the University Reception,
        Program Office, ACIC Startup Incubator, Gymnasium, and executive facilities.
      footer: 2 Internal Spaces
      tagStyle: 1
      gradientTop: {r: 0.255, g: 0.259, b: 0.439, a: 1}
      gradientBottom: {r: 0.063, g: 0.169, b: 0.298, a: 1}
      photo: {fileID: 0}
    exterior:
      tag1: ACADEMIC & ADMIN (EXTERIOR)
      tag2: "LIVE 360\xB0 VIEW"
      title: Gateway Building
      body: The Gateway Building is the flagship architectural centerpiece of the
        campus. It houses the University Reception, Program Office, ACIC Startup
        Incubator, Gymnasium, and executive facilities.
      narration: You are outside the Gateway Building, the architectural centerpiece
        housing the reception, program office, and executive facilities.
      status: OUTSIDE GATEWAY BUILDING
      photoCaption: Gateway Building Exterior
      chips:
      - University Reception
      - Program Office
      - ACIC Startup Incubator
      - Gymnasium & Executive Facilities
      photo: {fileID: 0}
    rooms:
    - selectorTitle: Reception
      selectorSubtitle: University Reception
      place:
        tag1: "GATEWAY \u2022 INTERIOR"
        tag2: "LIVE 360\xB0 VIEW"
        title: University Reception
        body: The University Reception is housed in the Gateway Building, the flagship
          architectural centerpiece of the campus.
        narration: Inside the Gateway Building, the University Reception welcomes
          you to campus.
        status: 'GATEWAY: RECEPTION'
        photoCaption: University Reception
        chips:
        - University Reception
        - Gateway Building
        photo: {fileID: 0}
    - selectorTitle: Program Office
      selectorSubtitle: Academic Program Office
      place:
        tag1: "GATEWAY \u2022 INTERIOR"
        tag2: "LIVE 360\xB0 VIEW"
        title: Program Office
        body: The Program Office is housed in the Gateway Building, alongside the
          University Reception, the ACIC Startup Incubator, and the executive facilities.
        narration: This is the Program Office, located in the Gateway Building next
          to the University Reception.
        status: 'GATEWAY: PROGRAM OFFICE'
        photoCaption: Program Office
        chips:
        - Program Office
        - Gateway Building
        - Executive Facilities
        photo: {fileID: 0}
  - id: mechanical-workshop
    name: Mechanical Workshop
    displayName: Mechanical Workshop
    card:
      tag: INDUSTRY & LABS
      title: Mechanical Workshop
      description: Siemens & Hero MotoCorp industry partnership hangar, industrial
        CNCs, 3D printing rapid prototyping lab, and student BAJA/Formula car bays.
      footer: Experiential Facility
      tagStyle: 2
      gradientTop: {r: 0.38, g: 0.286, b: 0.231, a: 1}
      gradientBottom: {r: 0.094, g: 0.173, b: 0.251, a: 1}
      photo: {fileID: 0}
    exterior:
      tag1: INDUSTRY & LABS (EXTERIOR)
      tag2: "LIVE 360\xB0 VIEW"
      title: Mechanical Workshop
      body: The Mechanical Workshop is an experiential facility with a Siemens &
        Hero MotoCorp industry partnership hangar, industrial CNCs, a 3D printing
        rapid prototyping lab, and student BAJA/Formula car bays.
      narration: You are outside the Mechanical Workshop, an experiential facility
        for industry partnerships, rapid prototyping, and student car projects.
      status: OUTSIDE MECHANICAL WORKSHOP BUILDING
      photoCaption: Mechanical Workshop Exterior
      chips:
      - Industry Partnership Hangar
      - Industrial CNCs
      - 3D Printing Lab
      - BAJA/Formula Car Bays
      photo: {fileID: 0}
    rooms: []
